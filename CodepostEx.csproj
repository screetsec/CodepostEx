<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Application -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CodepostEx</RootNamespace>
    <AssemblyName>CodepostEx</AssemblyName>
    <Version>0.2.0</Version>

    <!-- C# -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Single-file, self-contained Windows x64 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Native DLLs such as SQLite are extracted at runtime -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Compress bundled assemblies -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Bundle application content -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- CLI -->
    <PackageReference Include="System.CommandLine"
                      Version="2.0.0-beta4.22272.1" />

    <!-- SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite"
                      Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"
                      Version="2.1.12" />

    <!-- Dependency Injection / HTTP -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"
                      Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http"
                      Version="10.0.0" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging"
                      Version="10.0.0" />

    <!-- Cryptography -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData"
                      Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude tests -->
    <Compile Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded Resources -->
    <EmbeddedResource Include="Assets\template.html" />
    <EmbeddedResource Include="Assets\payloads\tasks.json" />
    <EmbeddedResource Include="Assets\payloads\hooks.json" />
    <EmbeddedResource Include="Assets\payloads\mcp.json" />
    <EmbeddedResource Include="Assets\payloads\settings.json" />
  </ItemGroup>

</Project>
